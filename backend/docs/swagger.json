{
    "swagger": "2.0",
    "info": {
        "description": "Possession-by-possession NBA game simulator API.",
        "title": "Sim1.0 API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/simulate": {
            "post": {
                "description": "Runs possessions until the game clock ends. Same seed produces the same game.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "simulate"
                ],
                "summary": "Simulate a full game",
                "parameters": [
                    {
                        "description": "Home/away team ids and optional seed",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.SimulateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.SimulateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/teams": {
            "get": {
                "description": "Returns team ids and names from teams.json",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "teams"
                ],
                "summary": "List all teams",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.ListTeamsResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_chengyang_sim1_0_backend_internal_sim.Event": {
            "type": "object",
            "properties": {
                "points": {
                    "type": "integer"
                },
                "possession": {
                    "type": "integer"
                },
                "team": {
                    "$ref": "#/definitions/github_com_chengyang_sim1_0_backend_internal_sim.Side"
                },
                "text": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "github_com_chengyang_sim1_0_backend_internal_sim.Side": {
            "type": "string",
            "enum": [
                "home",
                "away"
            ],
            "x-enum-varnames": [
                "Home",
                "Away"
            ]
        },
        "github_com_chengyang_sim1_0_backend_internal_sim.State": {
            "type": "object",
            "properties": {
                "away_id": {
                    "type": "string"
                },
                "away_name": {
                    "type": "string"
                },
                "away_score": {
                    "type": "integer"
                },
                "clock_sec": {
                    "type": "integer"
                },
                "home_id": {
                    "type": "string"
                },
                "home_name": {
                    "type": "string"
                },
                "home_score": {
                    "type": "integer"
                },
                "offense": {
                    "$ref": "#/definitions/github_com_chengyang_sim1_0_backend_internal_sim.Side"
                },
                "possession": {
                    "type": "integer"
                },
                "quarter": {
                    "type": "integer"
                },
                "status": {
                    "description": "in_progress | final",
                    "type": "string"
                }
            }
        },
        "internal_api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "unknown team id"
                }
            }
        },
        "internal_api.ListTeamsResponse": {
            "type": "object",
            "properties": {
                "teams": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_api.TeamOption"
                    }
                }
            }
        },
        "internal_api.SimulateRequest": {
            "type": "object",
            "properties": {
                "away_team_id": {
                    "type": "string",
                    "example": "BOS"
                },
                "home_team_id": {
                    "type": "string",
                    "example": "LAL"
                },
                "seed": {
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "internal_api.SimulateResponse": {
            "type": "object",
            "properties": {
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_chengyang_sim1_0_backend_internal_sim.Event"
                    }
                },
                "seed": {
                    "type": "integer",
                    "example": 42
                },
                "state": {
                    "$ref": "#/definitions/github_com_chengyang_sim1_0_backend_internal_sim.State"
                }
            }
        },
        "internal_api.TeamOption": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "LAL"
                },
                "name": {
                    "type": "string",
                    "example": "Lakers"
                }
            }
        }
    }
}